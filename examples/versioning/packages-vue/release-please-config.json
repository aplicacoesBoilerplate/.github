{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "packages": {
    "packages/composables": {
      "release-type": "node",
      "component": "composables"
    },
    "packages/utils": {
      "release-type": "node",
      "component": "utils"
    },
    "packages/ui/core": {
      "release-type": "node",
      "component": "ui-core"
    },
    "packages/ui/prime-vue": {
      "release-type": "node",
      "component": "ui-prime-vue"
    },
    "packages/ui/vuetify": {
      "release-type": "node",
      "component": "ui-vuetify"
    }
  },
  "plugins": [
    "node-workspace"
  ]
}
