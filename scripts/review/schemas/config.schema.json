{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "automation_actors", "llm_configs", "protected_branches", "correctable_prefixes", "allowed_paths", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "reviewer": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$" },
    "automation_actors": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "login"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "login": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}(?:\\[bot\\])?$" }
        }
      }
    },
    "llm_configs": {
      "type": "object", "additionalProperties": false, "required": ["review", "correction"],
      "properties": { "review": { "$ref": "#/definitions/path" }, "correction": { "$ref": "#/definitions/path" } }
    },
    "protected_branches": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "correctable_prefixes": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "allowed_paths": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "checks": { "$ref": "triage-policy#/properties/checks" },
    "triage_handoff": {
      "type": "object", "additionalProperties": false, "required": ["workflow_path", "config_path", "finish_job"],
      "properties": {
        "workflow_path": { "$ref": "#/definitions/path" }, "config_path": { "$ref": "#/definitions/path" },
        "finish_job": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f]+$" }
      }
    }
  },
  "definitions": { "path": { "type": "string", "minLength": 1, "maxLength": 240 } }
}
