{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["summary", "findings", "patch"],
  "properties": {
    "summary": { "type": "string", "maxLength": 4000 },
    "patch": { "type": ["string", "null"] },
    "findings": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["severity", "path", "line", "message"],
        "properties": {
          "severity": { "enum": ["critical", "warning", "suggestion"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
