{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "fields", "llm_configs", "reviewer", "allowed_paths", "checks", "stacked_bases"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["owner", "number"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$" },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "fields": {
      "type": "object", "additionalProperties": false, "required": ["effort", "size", "estimate", "release"],
      "properties": { "effort": { "$ref": "#/definitions/field" }, "size": { "$ref": "#/definitions/field" }, "estimate": { "$ref": "#/definitions/field" }, "release": { "$ref": "#/definitions/field" } }
    },
    "llm_configs": {
      "type": "object", "additionalProperties": false, "required": ["plan", "patch"],
      "properties": { "plan": { "$ref": "#/definitions/path" }, "patch": { "$ref": "#/definitions/path" } }
    },
    "reviewer": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$" },
    "allowed_paths": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command", "args"],
        "properties": {
          "command": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$" },
          "args": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 4096 } }
        }
      }
    },
    "stacked_bases": {
      "type": "object", "maxProperties": 100,
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  },
  "definitions": {
    "field": { "type": "string", "minLength": 1, "maxLength": 100 },
    "path": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}
