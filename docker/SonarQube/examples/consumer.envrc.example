# Copie para .envrc na raiz de CADA projeto consumidor (nao versionar).
# Git Bash no Windows: pwd -W devolve o caminho absoluto no formato C:/...
export SONAR_PROJECT_PATH="$(pwd -W)"

# Mapeie a variavel fixa SONAR_TOKEN para a variavel externa deste projeto.
# SQP_K6 e apenas um exemplo de nome; o valor do token nao fica no .envrc.
export SONAR_TOKEN="$SQP_K6"

# SQB_STACK_COMPOSE pertence ao ambiente de usuario do Windows; o Git Bash
# cria o alias SONAR_STACK_COMPOSE para o scanner.

# Opcional: apenas se usar SonarQube CLI ou MCP. Use um User Token externo,
# distinto do Project Analysis token acima. Ajuste o nome da variavel externa.
# SONARQUBE_TOKEN, SQB_URL e SQB_CLI_SERVER pertencem ao Windows.
# SONARQUBE_CLI_TOKEN, SONARQUBE_URL e SONARQUBE_CLI_SERVER sao aliases do Git Bash.
# export SONARQUBE_PROJECT_KEY='minha-chave-de-projeto'

# MCPs ativos globalmente no Codex. O perfil Docker e escolhido pelo consumidor;
# o PAT de GitHub vem de uma variavel externa especifica do projeto.
# API_KEY_CONTEXT7 e global; nao precisa ser repetida aqui.
# export PROFILE_TOOLKIT='perfil-deste-projeto'
# export GITHUB_PERSONAL_ACCESS_TOKEN="$PAT_DESTE_PROJETO"
