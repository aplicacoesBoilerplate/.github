{
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "docs/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}