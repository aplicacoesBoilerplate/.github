# PROTÓTIPO DE CONTRATO, não instalado em .github/workflows.
# Substituir PINNED_CENTRAL_SHA após implementar e revisar o workflow central.
name: Análise LLM do consumidor
on:
  workflow_dispatch:

permissions:
  contents: read
  actions: read

jobs:
  llm:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    uses: aplicacoesBoilerplate/.github/.github/workflows/llm-execute.yml@PINNED_CENTRAL_SHA
    with:
      invocation_id: analyze-main
      config_path: .github/llm/analyze.json
      source_ref: ${{ github.event.repository.default_branch }}
      context_json: '{"request":"Analisar o projeto e devolver recomendações sem editar arquivos."}'
      auth_mode: chatgpt-session
      session_secret_name: CLI_CODEX_SESSION
    secrets:
      CODEX_AUTH_JSON: ${{ secrets.CLI_CODEX_SESSION }}
      CODEX_AUTH_WRITE_PAT: ${{ secrets.CLI_CODEX_SESSION_WRITE_PAT }}

  inspect-result:
    needs: llm
    if: needs.llm.result == 'success' && needs.llm.outputs.status == 'succeeded'
    runs-on: ubuntu-24.04
    permissions: {}
    steps:
      - name: Baixar resultado desta execução
        uses: actions/download-artifact@PINNED_DOWNLOAD_ARTIFACT_SHA
        with:
          name: ${{ needs.llm.outputs.artifact_name }}
          path: llm-result
      # O consumidor valida schema/proveniência/SHA antes de qualquer ação de domínio.
      # Este protótipo termina no download; não aplica patch nem abre PR.
